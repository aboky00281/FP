                                                                    printWindow.document.write('<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 999999; overflow: hidden; display: flex; flex-wrap: wrap; justify-content: space-around; align-content: space-around; user-select: none;">');
                                                                    for (let i = 0; i < 8; i++) {
                                                                        printWindow.document.write('<div style="transform: rotate(-30deg); font-size: 32px; font-weight: bold; color: #f1f5f9; font-family: sans-serif; margin: 150px; white-space: nowrap;">HYDCAL - FREE VERSION</div>');
                                                                    }
                                                                    printWindow.document.write('</div>');
                                                                }
                                                                if (reportData.isForInformation) {
                                                                    printWindow.document.write('<div style="position: fixed; inset: 0; z-index: 10000; pointer-events: none; display: flex; align-items: center; justify-content: center; overflow: hidden;"><div style="text-align: center; color: #fee2e2; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; transform: rotate(-45deg); font-size: 55px; line-height: 1.2; max-width: 100%; word-wrap: break-word; margin-top: auto; margin-bottom: auto;">' + (reportData.watermarkText || 'FOR INFORMATION') + '</div></div>');
                                                                }
                                                                const modalBody = document.querySelector('.p-6.overflow-auto');
                                                                if (modalBody) {
                                                                    printWindow.document.write(modalBody.innerHTML);
                                                                } else {
                                                                    printWindow.document.write(document.body.innerHTML);
                                                                }
                                                                printWindow.document.write('<' + '/body><' + '/html>');
                                                                printWindow.document.close();
                                                                printWindow.focus();
                                                                setTimeout(() => {
                                                                    printWindow.print();
                                                                }, 800);
                                                            } else {
                                                                alert("ระบบจำลอง (Sandbox) บล็อกระบบป๊อปอัพสำหรับการพิมพ์\n\n- กรุณากดปุ่มพิมพ์ที่คีย์บอร์ด [ Ctrl + P ] เพื่อสั่งพิมพ์โดยตรง\n- หรือดาวน์โหลดไฟล์ HTML นี้เปิดใช้งานในคอมพิวเตอร์ส่วนตัวครับ");
                                                                window.print();
                                                            }
                                                        } else {
                                                            window.print();
                                                        }
                                                    } catch (err) {
                                                        alert("ขออภัย! ระบบบล็อกปุ่มพิมพ์ในหน้าเว็บนี้\n\nกรุณากดปุ่มคีย์ลัดบนคีย์บอร์ด [ Ctrl + P ] เพื่อสั่งพิมพ์โดยตรง\nหรือดาวน์โหลดไฟล์ HTML นี้มาเปิดบนเครื่องเพื่อใช้งานระบบพิมพ์ที่สมบูรณ์ครับ");
                                                        try {
                                                            window.print();
                                                        } catch (e) {}
                                                    }
                                                }}
                                                className="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded hover:bg-gray-50 font-medium flex items-center gap-2"
                                            >
                                                Print
                                            </button>
                                            <button
                                                onClick={() => setShowReport(false)}
                                                className="px-4 py-2 bg-gray-900 text-white rounded hover:bg-gray-800 font-medium"
                                            >
                                                Close
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        )
                    }
                </div>
            );
        };

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>

</body>

</html>
