                                const nextSprinklers = placedSprinklers.map(s => {
                                    let sx = s.x;
                                    let sy = s.y;
                                    if (viewMode === 'iso') {
                                        const k = `${s.x.toFixed(4)},${s.y.toFixed(4)}`;
                                        const off = isoMap[k] || { x: 0, y: 0 };
                                        sx += off.x;
                                        sy += off.y;
                                    }
                                    if (sx >= minX && sx <= maxX && sy >= minY && sy <= maxY) {
                                        return { ...s, active: !(s.active !== false) };
                                    }
                                    return s;
                                });
                                setPlacedSprinklers(nextSprinklers);
                                setResults([]);
                                setTotalDemand({ flow: 0, pressure: 0 });
                                commitToHistory(drawnPipes, nextSprinklers, placedEquipments);
                            }
                        } else if (mode === 'toggle_spk') {
                            const rawCoords = getCanvasCoords(e);
                            const clickThreshold = 10 / transform.scale;
                            const sprinklerToToggle = placedSprinklers.find(s => {
                                let sx = s.x; let sy = s.y;
                                if (viewMode === 'iso') {
                                    const k = `${s.x.toFixed(4)},${s.y.toFixed(4)}`;
                                    const off = isoMap[k] || { x: 0, y: 0 };
                                    sx += off.x; sy += off.y;
                                }
                                return Math.sqrt(Math.pow(sx - rawCoords.x, 2) + Math.pow(sy - rawCoords.y, 2)) < clickThreshold;
                            });
                            if (sprinklerToToggle) {
                                const nextSprinklers = placedSprinklers.map(s => s.id === sprinklerToToggle.id ? { ...s, active: !(s.active !== false) } : s);
                                setPlacedSprinklers(nextSprinklers);
